# ==============================================================================
# SHRI KRISHNA AGRO SERVICES (श्री कृष्ण ॲग्रो सर्व्हिसेस, सिन्नर)
# Enterprise Environment Configuration Template
# ==============================================================================

# 1. APPLICATION ENVIRONMENT
NODE_ENV=production
PORT=3000
NEXT_PUBLIC_BASE_PATH="" # Set to "/shrikrushna-agro-services" for GitHub Pages subpath, or "" for root custom domain
NEXT_PUBLIC_API_URL="" # Set to backend server URL if frontend is decoupled (e.g. "https://api.shrikrushnaagro.com")

# 2. RELATIONAL DATABASE (PostgreSQL with Prisma ORM)
# Example: postgresql://username:password@localhost:5432/shrikrishna_agro?schema=public
DATABASE_URL="postgresql://postgres:postgres_password@localhost:5432/shrikrishna_agro_db?schema=public"

# 3. AUTHENTICATION & SECURITY (MANDATORY IN PRODUCTION)
# Generate a cryptographically secure 256-bit secret using: openssl rand -base64 32
JWT_SECRET="generate_secure_random_jwt_secret_min_32_chars_in_production"

# 4. LIVE AI AGRONOMIST SERVICE (Optional live cloud LLM fallback)
AI_API_KEY="" # Google Gemini or Anthropic Claude API Key

# 5. META WHATSAPP CLOUD API (Optional live WhatsApp gateway)
WHATSAPP_API_KEY=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""

# 6. BUSINESS IDENTIFIERS (Sinnar Store)
NEXT_PUBLIC_STORE_NAME="Shri Krishna Agro Services"
NEXT_PUBLIC_STORE_LOCATION="Sinnar, Nashik, Maharashtra - 422103"
NEXT_PUBLIC_PRIMARY_PHONE="8605620843" # Shubham Gamane
NEXT_PUBLIC_SECONDARY_PHONE="8888474456" # Jagdish Bodke
